{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile"
  },
  "deploy": {
    "startCommand": "gunicorn --workers 1 --threads 8 --bind 0.0.0.0:$PORT --timeout 120 wsgi:app",
    "healthcheckPath": "/health",
    "restartPolicyType": "ALWAYS"
  }
}
